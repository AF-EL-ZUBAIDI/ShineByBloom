---
// Responsive photo from public/media (generated by scripts/prepare-media.py).
interface Props {
  slug: string;
  alt: string;
  sizes?: string;
  eager?: boolean;
  class?: string;
}
const { slug, alt, sizes = "(min-width: 900px) 40vw, 90vw", eager = false, class: cls } = Astro.props;
---

<img
  class={cls}
  src={`/media/${slug}-800.webp`}
  srcset={`/media/${slug}-800.webp 800w, /media/${slug}-1600.webp 1600w`}
  sizes={sizes}
  alt={alt}
  width="800"
  height="1067"
  loading={eager ? "eager" : "lazy"}
  decoding="async"
  fetchpriority={eager ? "high" : undefined}
/>
