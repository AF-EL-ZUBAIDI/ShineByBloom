{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shinebybloom",
  "compatibility_date": "2024-11-01",
  // Only shinebybloom.com serves the site: no *.workers.dev address, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  }
}
