{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shinebybloom",
  "compatibility_date": "2024-11-01",
  // Only custom domains serve the site: no *.workers.dev address, no preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist"
  },
  // Dev site: a second Worker, deployed from the `dev` branch with
  // `npx wrangler deploy --env dev` and served at dev.shinebybloom.com.
  "env": {
    "dev": {
      "name": "shinebybloom-dev"
    }
  }
}
